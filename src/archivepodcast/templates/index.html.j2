<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>
        {{ app_config['web_page']['title']|e }}
    </title>
    {% include "_head_meta.html.j2" %}
    <script type="module" src="/static/clipboard.js"></script>
</head>

<body>
    <main class="contained-content podcast-index">
        <h1>{{ app_config['web_page']['title']|e }}</h1>
        {{ header | safe }}
        <p class="page-description">{{ app_config['web_page']['description']|e }}</p>
        <p>For instructions on how to add a podcast url to a podcast app, <a href="/guide.html">check out the
                guide</a>.
        </p>
        {%- for podcast in podcasts %}
        <h2>{{ podcast['new_name']|e }}</h2>
        {% if podcast['description'] %}<p>{{ podcast['description']|e }}</p>{% endif -%}
        {% set rss_url = app_config['inet_path'] ~ 'rss/' ~ podcast['name_one_word'] -%}
        {% set bare_url = rss_url.split('://', 1)[1] -%}
        <div class="podcast-links">
            <a class="button button-pocketcasts" href="pktc://subscribe/{{ bare_url }}">Pocket Casts</a>
            <a class="button button-apple" href="podcast://{{ bare_url }}">Apple Podcasts</a>
            <a class="button button-youtube"
                href="https://music.youtube.com/library/podcasts?addrssfeed={{ rss_url | b64encode | urlencode }}">YouTube
                Music</a>
            <a class="button" href="{{ rss_url }}" data-url="{{ rss_url }}"
                onclick="window.grabToClipboard('{{ podcast['name_one_word']}}'); return false;"
                id="{{ podcast['name_one_word']}}_button">Copy URL</a>
        </div>{% endfor %}
        <footer>
            <hr>
            Contact: <a href="mailto:{{ app_config['web_page']['contact']|e }}">{{
                app_config['web_page']['contact']|e }}</a>
        </footer>
    </main>
</body>

</html>
