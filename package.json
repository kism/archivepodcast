{
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cspell/dict-en-au": "^1.1.27",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/noto-sans-display": "^5.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cspell": "^9.8.0",
    "happy-dom": "^20.14.5",
    "html-validate": "^10.17.0",
    "markdownlint-cli": "^0.46.0",
    "playwright": "^1.63.0",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "node --run vitest run --coverage",
    "check": "biome check",
    "lint": "biome lint .",
    "spell": "bunx cspell '**/*.{py,js,css,html,md,json,Dockerfile}'",
    "check_markdown": "bunx markdownlint --ignore node_modules --fix ./**/*.md",
    "format": "biome format --write .",
    "update_fonts": "bun scripts/update_fonts.mjs",
    "check_fonts": "bun scripts/check_fonts.mjs"
  }
}
